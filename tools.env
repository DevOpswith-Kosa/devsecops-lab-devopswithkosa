# Pinned versions of every tool the pipeline runs.
# Read by the Makefile (local runs) and by the pipeline (CI runs), so a scan
# on your laptop and a scan in GitHub Actions use exactly the same version.
# Bump them on purpose, in a pull request, like any other dependency.
CLUSTER_NAME=devsecops
REGISTRY=localhost:5001
IMAGE_NAME=kubenotes
KIND_NODE_IMAGE=kindest/node:v1.37.0
GATEKEEPER_VERSION=v3.23.1
TRIVY_IMAGE=aquasec/trivy:0.76.2
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1
SEMGREP_IMAGE=semgrep/semgrep:1.186.0
HADOLINT_IMAGE=hadolint/hadolint:v2.15.1
CONFTEST_IMAGE=openpolicyagent/conftest:v0.71.1
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:2.17.0
ACTIONLINT_IMAGE=rhysd/actionlint:1.7.12
ZIZMOR_IMAGE=ghcr.io/zizmorcore/zizmor:1.32.0
KUBESCAPE_IMAGE=quay.io/kubescape/kubescape-cli:v4.0.21
KUBEBENCH_IMAGE=docker.io/aquasec/kube-bench:v0.16.0
